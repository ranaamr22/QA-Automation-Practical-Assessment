{
  "name": "eventhub-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test automation framework for the EventHub ticket-booking platform (US-114).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=ui --grep @e2e",
    "test:e2e:api": "playwright test --project=api --grep @e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "browsers:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
